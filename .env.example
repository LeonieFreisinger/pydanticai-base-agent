# SQL Agent Showcase - Environment Variables
# Copy to .env and fill in your API keys

# =============================================================================
# LLM Provider Configuration
# =============================================================================

# Which provider to use: openai, anthropic, or google
LLM_PROVIDER=openai

# Model name (provider-specific)
# OpenAI: gpt-4.1, gpt-4o, gpt-4o-mini, o1, o3-mini
# Anthropic: claude-sonnet-4-20250514, claude-3-5-haiku-latest
# Google: gemini-2.0-flash, gemini-1.5-pro
MODEL_NAME=gpt-4.1

# =============================================================================
# API Keys (set the one for your chosen provider)
# =============================================================================

OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...

# =============================================================================
# Demo Configuration
# =============================================================================

# Demo level controls which features are active:
# 1 = Structured output only (no tools, no execution)
# 2 = Schema exploration (list_tables, describe_table)
# 3 = Full query execution (all tools)
# 4 = Full + ModelRetry + streaming + Langfuse tracing
DEMO_LEVEL=4

# =============================================================================
# Langfuse Observability (Optional, requires Level 4)
# =============================================================================

# Enable Langfuse tracing (true/false)
ENABLE_LANGFUSE=false

# Langfuse credentials (get from https://cloud.langfuse.com)
# LANGFUSE_PUBLIC_KEY=pk-...
# LANGFUSE_SECRET_KEY=sk-...
# LANGFUSE_HOST=https://cloud.langfuse.com
